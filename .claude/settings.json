{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(.*)",
      "Read(.*)",
      "Write(.*)",
      "Edit(.*)",
      "Glob(.*)",
      "Grep(.*)",
      "mcp__unity",
      "mcp__pencil"
    ],
    "deny": []
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type SessionEnd",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/qx/hooks/qx-workflow-record-hook.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/qx/hooks/qx-guard-hook.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/qx/hooks/qx-skill-detect-hook.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type Notification",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/qx/hooks/qx-loop-hook.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/qx/hooks/qx-workflow-stop-hook.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type Stop --add-chat",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type SubagentStop",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type PermissionRequest",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run .claude/hooks/send_observability_event.py --source-app ET --event-type PreCompact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
