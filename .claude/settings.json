{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(.*)",
      "Read(.*)",
      "Write(.*)",
      "Edit(.*)",
      "Glob(.*)",
      "Grep(.*)",
      "mcp__unity",
      "mcp__pencil"
    ],
    "deny": []
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/qx/hooks/qx-loop-hook.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/qx/hooks/qx-guard-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
